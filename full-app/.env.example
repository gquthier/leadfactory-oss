# LeadFactory : configuration locale par défaut. Aucun secret n’est fourni.
# Facultatif : copier vers .env.local ; ne jamais committer ce fichier personnel.
# Garder full-app dans le pack parent pour les prompts, skills et CLI.
LEADFACTORY_DATA_MODE=local
NEXT_PUBLIC_LEADFACTORY_DATA_MODE=local
LEADFACTORY_CONNECT_DATABASE=0
LEADFACTORY_ENABLE_EXTERNAL=0

# Après import SQL manuel dans VOTRE projet Supabase vide uniquement :
# activer ensemble les deux modes supabase + CONNECT_DATABASE=1.
# Les anciennes API distantes exigent aussi ENABLE_EXTERNAL=1 et leur recette.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=

# Parcours courant : saisir les tokens personnels dans Start Here.
# Ils sont stockés côté serveur dans .local-data/integrations.json (0600).
# Les variables ci-dessous concernent les adaptateurs historiques, pas une
# importation automatique dans les connexions du starter. Toutes facultatives.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# Meta : vos actifs uniquement, version Graph API à vérifier dans votre app.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=
FB_APP_ID=
FB_APP_SECRET=
META_REDIRECT_URI=
META_LOGIN_CONFIG_ID=
META_VERIFY_TOKEN=
NEXT_PUBLIC_META_OAUTH_ENABLED=

# Messagerie : choisir et recetter un fournisseur avant un envoi explicite.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_DOMAIN=
BREVO_API_KEY=
BREVO_FROM=
RESEND_API_KEY=

# Autres adaptateurs historiques facultatifs.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
APP_ENCRYPTION_KEY=
APIFY_TOKEN=
APIFY_ACTOR_GMAPS=
SCRAPER_MAX_RESULTS_PER_JOB=
NOTION_API_KEY=
NOTION_CAMPAIGN_DATABASE_ID=
FATHOM_API_KEY=
FATHOM_API_KEYS=

# Automatisations : aucune cible historique et aucun démarrage automatique.
LEADFACTORY_AUTOMATION_WEBHOOK_URL=
LEADFACTORY_AUTOMATION_WEBHOOK_TOKEN=
INTERNAL_TRIGGER_SECRET=
CRON_SECRET=

# Livrables locaux : dossier absolu personnel dédié, facultatif.
# Vide : aucune découverte ni lecture de fichiers locaux via cet adaptateur.
LF_DELIVERABLES_DIR=
LEADFACTORY_INTEGRATION_VIDEO_URL=

# Facultatif : répertoire local distinct pour une démonstration isolée.
LEADFACTORY_STARTER_DATA_DIR=
